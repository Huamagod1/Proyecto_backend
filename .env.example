# .env.example · variables de entorno del proyecto (Fase 1; cada fase agrega las suyas).
# Copia este archivo a .env (`cp .env.example .env`) y pon tus valores.
# SEGURIDAD: aquí solo hay valores de ejemplo. Las claves reales viven en .env, que Git ignora.
# OJO: los comentarios van en su propia línea. Este formato lo leen igual Node (--env-file) y
# Docker Compose (sustitución de ${VARIABLES} en docker-compose.yml).

# Puerto HTTP de la API.
PUERTO=3000

# Secreto para firmar los JWT (Fase 4): 32 caracteres o más. Genera uno con `openssl rand -hex 32`.
JWT_SECRETO=cambia-esto-por-32-caracteres-o-mas

# Clave de root de MySQL. Docker Compose la usa al crear la base (Fase 2).
MYSQL_ROOT_PASSWORD=cambia-esta-clave-de-root

# MySQL visto desde tu equipo: el puerto 3306 que publica el contenedor.
DB_HOST=127.0.0.1
DB_PUERTO=3306
# Usuario de la API, con permisos mínimos (sql/003_usuario_app.sh). Su clave también la usa ese script.
DB_USUARIO=telemetria_app
DB_CLAVE=cambia-esta-clave
DB_NOMBRE=telemetria

# Contraseñas de los usuarios que crea `npm run sembrar` (Fase 4). Las pruebas también las usan.
# SEGURIDAD: 12 caracteres o más. Genera cada una con `openssl rand -hex 12`.
CLAVE_ADMIN=cambia-esta-clave-admin
CLAVE_ING_NORTE=cambia-esta-clave-ing
CLAVE_LECTOR_SUR=cambia-esta-clave-lector
CLAVE_GW_NORTE=cambia-esta-clave-gateway

# Broker MQTT (Fase 6).
MQTT_URL=mqtt://127.0.0.1:1883
# Credenciales de la API en el broker (Fase 6, paso 9). claves-mqtt.sh crea el usuario con esta clave.
MQTT_USUARIO=api
MQTT_CLAVE=cambia-esta-clave-mqtt
# Credenciales del gateway del sitio norte (Fase 7). La ACL solo le deja escribir en motores/norte/#.
GATEWAY_MQTT_USUARIO=gw-norte
GATEWAY_MQTT_CLAVE=cambia-esta-clave-gw-mqtt

# Gateway Modbus (Fase 7). Dónde está el simulador (o el controlador real).
MODBUS_HOST=127.0.0.1
MODBUS_PUERTO=5020
# Identidad del gateway: su id y su sitio forman los tópicos (motores/norte/...).
GATEWAY_ID=gw-norte
GATEWAY_SITIO=norte
# Equipos que lee: "unitId:motor" separados por coma.
GATEWAY_EQUIPOS=1:MTR-01,2:MTR-02
# Archivo SQLite del buffer store-and-forward (la carpeta datos/ la ignora Git).
GATEWAY_BUFFER=./datos/buffer.sqlite
# Milisegundos entre lecturas de cada equipo.
GATEWAY_PERIODO_MS=5000

# Publicador CAN J1939 del sitio sur (Fase 8, npm run can). La ACL solo le deja escribir en motores/sur/#.
CAN_MQTT_USUARIO=gw-sur
CAN_MQTT_CLAVE=cambia-esta-clave-can
