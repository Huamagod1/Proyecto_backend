# .env.example · variables de entorno del proyecto (Fase 1; cada fase agrega las suyas).
# Copia este archivo a .env (`cp .env.example .env`) y pon tus valores.
# SEGURIDAD: aquí solo hay valores de ejemplo. Las claves reales viven en .env, que Git ignora.
# OJO: los comentarios van en su propia línea. Este formato lo leen igual Node (--env-file) y
# Docker Compose (sustitución de ${VARIABLES} en docker-compose.yml).

# Puerto HTTP de la API.
PUERTO=3000

# Secreto para firmar los JWT (Fase 4): 32 caracteres o más. Genera uno con `openssl rand -hex 32`.
JWT_SECRETO=cambia-esto-por-32-caracteres-o-mas

# Clave de root de MySQL. Docker Compose la usa al crear la base (Fase 2).
MYSQL_ROOT_PASSWORD=cambia-esta-clave-de-root

# MySQL visto desde tu equipo: el puerto 3306 que publica el contenedor.
DB_HOST=127.0.0.1
DB_PUERTO=3306
# Usuario de la API, con permisos mínimos (sql/003_usuario_app.sh). Su clave también la usa ese script.
DB_USUARIO=telemetria_app
DB_CLAVE=cambia-esta-clave
DB_NOMBRE=telemetria

# Broker MQTT (Fase 6).
MQTT_URL=mqtt://127.0.0.1:1883
