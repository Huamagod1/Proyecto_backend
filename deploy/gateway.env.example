# gateway.env.example · plantilla de /etc/telemetria/gateway.env (Fase 13). Sin valores reales.
# Instalar: sudo install -m 600 -o root -g root gateway.env.example /etc/telemetria/gateway.env y editar.
MODBUS_HOST=127.0.0.1
MODBUS_PUERTO=5020
GATEWAY_ID=gw-norte
GATEWAY_SITIO=norte
GATEWAY_EQUIPOS=1:MTR-01,2:MTR-02
# La única carpeta donde el servicio puede escribir (ReadWritePaths en la unidad de systemd).
GATEWAY_BUFFER=/var/lib/telemetria/buffer.sqlite
GATEWAY_PERIODO_MS=5000
MQTT_URL=mqtt://127.0.0.1:1883
GATEWAY_MQTT_USUARIO=gw-norte
GATEWAY_MQTT_CLAVE=cambia-esta-clave-gw-mqtt
