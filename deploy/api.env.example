# api.env.example · plantilla de /etc/telemetria/api.env (Fase 13). Sin valores reales.
# Instalar: sudo install -m 600 -o root -g root api.env.example /etc/telemetria/api.env y editar.
# SEGURIDAD: 600 y dueño root = solo root lo lee; systemd lo carga antes de bajar al usuario telemetria.
PUERTO=3000
# Nginx está delante: la API toma la IP real de X-Forwarded-For (ver src/api/app.js).
CONFIAR_PROXY=1
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=telemetria_app
DB_CLAVE=cambia-esta-clave
DB_NOMBRE=telemetria
JWT_SECRETO=cambia-esto-por-32-caracteres-o-mas
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USUARIO=api
MQTT_CLAVE=cambia-esta-clave-mqtt
